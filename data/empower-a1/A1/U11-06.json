[
 {
  "id": 1,
  "start": 0.357,
  "end": 2.73,
  "text": "Track 11.06"
 },
 {
  "id": 2,
  "start": 4.19,
  "end": 5.754,
  "text": "What are you reading?"
 },
 {
  "id": 3,
  "start": 6.072,
  "end": 9.096,
  "text": "Oh, it’s about Valentina Tereshkova."
 },
 {
  "id": 4,
  "start": 9.406,
  "end": 10.317,
  "text": "Who’s she?"
 },
 {
  "id": 5,
  "start": 10.516,
  "end": 12.277,
  "text": "She’s a Russian cosmonaut."
 },
 {
  "id": 6,
  "start": 12.452,
  "end": 13.691,
  "text": "Do you know about her?"
 },
 {
  "id": 7,
  "start": 13.951,
  "end": 16.165,
  "text": "No. What did she do?"
 },
 {
  "id": 8,
  "start": 16.351,
  "end": 19.257,
  "text": "Well, she was the first woman in space."
 },
 {
  "id": 9,
  "start": 19.379,
  "end": 22.387,
  "text": "She went into space in 1963."
 },
 {
  "id": 10,
  "start": 22.767,
  "end": 26.242,
  "text": "It says here 400 people wanted the job,"
 },
 {
  "id": 11,
  "start": 26.484,
  "end": 27.722,
  "text": "but they asked her."
 },
 {
  "id": 12,
  "start": 27.852,
  "end": 29.542,
  "text": "Why did they ask her?"
 },
 {
  "id": 13,
  "start": 30.113,
  "end": 31.723,
  "text": "Well, she was young,"
 },
 {
  "id": 14,
  "start": 31.919,
  "end": 33.562,
  "text": "and she was quite small."
 },
 {
  "id": 15,
  "start": 33.835,
  "end": 36.635,
  "text": "And she also did a lot of parachute jumping."
 },
 {
  "id": 16,
  "start": 37.059,
  "end": 39.718,
  "text": "Oh, so she went in planes a lot."
 },
 {
  "id": 17,
  "start": 39.991,
  "end": 43.11,
  "text": "Yes! And she married a cosmonaut, too."
 },
 {
  "id": 18,
  "start": 43.382,
  "end": 45.929,
  "text": "She met him in 1963."
 },
 {
  "id": 19,
  "start": 46.319,
  "end": 48.422,
  "text": "He was on the same space programme."
 },
 {
  "id": 20,
  "start": 48.756,
  "end": 50.327,
  "text": "And they had a daughter."
 },
 {
  "id": 21,
  "start": 50.515,
  "end": 53.182,
  "text": "So, did she go into space again?"
 },
 {
  "id": 22,
  "start": 53.426,
  "end": 55.744,
  "text": "No, she only went once."
 },
 {
  "id": 23,
  "start": 56.065,
  "end": 59.248,
  "text": "But she said she would like to fly to Mars one day."
 },
 {
  "id": 24,
  "start": 59.648,
  "end": 61.854,
  "text": "She said that when she was 70!"
 }
]