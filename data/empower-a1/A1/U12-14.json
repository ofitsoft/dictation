  "start": 37.666,
  "end": 40.809,
  "text": "So what are you going to do this weekend, Marcus?"
 },
 {
  "id": 17,
  "start": 40.834,
  "end": 42.762,
  "text": "Well, on Saturday"
 },
 {
  "id": 18,
  "start": 42.787,
