  "end": 22.52,
  "text": "So, where are the cups?"
 },
 {
  "id": 4,
  "start": 22.545,
  "end": 25.315,
  "text": "OK, let’s see."
 },
 {
  "id": 5,
  "start": 25.436,
  "end": 26.269,
  "text": "Ah ..."
 },
 {
  "id": 6,
  "start": 29.477,
  "end": 31.096,
  "text": "These cups are nice."
 },
 {
  "id": 7,
  "start": 31.152,
  "end": 32.215,
  "text": "Yes, they are."
 },
 {
  "id": 8,
  "start": 32.24,
  "end": 34.296,
  "text": "But there are only three."
 },
 {
  "id": 9,
  "start": 34.582,
  "end": 35.439,
  "text": "Can I help you?"
 },
 {
  "id": 10,
  "start": 35.565,
  "end": 37.127,
  "text": "Yes, how much are these cups?"
 },
 {
  "id": 11,
  "start": 37.152,
  "end": 39.223,
  "text": "They’re five pounds each."
 },
 {
  "id": 12,
  "start": 39.384,
  "end": 40.605,
  "text": "That’s a good price."
 },
 {
  "id": 13,
  "start": 40.842,
  "end": 42.024,
  "text": "But I need six."
 },
 {
  "id": 14,
  "start": 42.12,
  "end": 43.334,
  "text": "Do you have any more?"
 },
 {
  "id": 15,
  "start": 43.359,
  "end": 45.375,
  "text": "No, I’m sorry. We only have three."
 },
 {
  "id": 16,
  "start": 45.939,
  "end": 46.883,
  "text": "Oh dear."
 },
 {
  "id": 17,
  "start": 46.908,
  "end": 49.495,
  "text": "These cups are the same price."
 },
 {
  "id": 18,
  "start": 52.102,
  "end": 54.365,
  "text": "Mm … no … I don’t think so."
 },
 {
  "id": 19,
  "start": 54.517,
  "end": 55.803,
  "text": "Can I look around?"
 },
 {
  "id": 20,
  "start": 55.961,
  "end": 56.787,
  "text": "Of course."
 },
 {
  "id": 21,
  "start": 66.194,
  "end": 68.466,
  "text": "Sophia, these cups are really nice."
 },
 {
  "id": 22,
  "start": 68.723,
  "end": 71.088,
  "text": "Yes, they are. But I need six."
 },
 {
  "id": 23,
  "start": 71.378,
  "end": 74.855,
  "text": "Yes, I know … but not for you … for me!"
 },
 {
  "id": 24,
  "start": 75.224,
  "end": 75.909,
  "text": "Oh."
 },
 {
  "id": 25,
  "start": 75.934,
  "end": 77.473,
  "text": "Do you need some cups too?"
 },
 {
  "id": 26,
  "start": 77.523,
  "end": 80.17,
  "text": "Not really, but I really like them …"
 },
 {
  "id": 27,
  "start": 80.466,
  "end": 82.26,
  "text": "and they’re so cheap."
 },
 {
  "id": 28,
  "start": 83.276,
  "end": 84.339,
  "text": "Excuse me"
 },
 {
  "id": 29,
  "start": 85.747,
  "end": 87.461,
  "text": "… I’d like two of these cups, please."
 },
 {
  "id": 30,
  "start": 87.588,
  "end": 88.303,
  "text": "Certainly."
 }
