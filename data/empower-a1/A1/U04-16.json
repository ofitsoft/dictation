 },
 {
  "id": 3,
  "start": 5.508,
  "end": 6.921,
  "text": "Yeah …"
 },
 {
  "id": 4,
  "start": 7.429,
  "end": 9.413,
  "text": "Do you have photos of your family?"
 },
 {
  "id": 5,
  "start": 9.835,
  "end": 11.676,
  "text": "Yes. Yes, I do."
 },
 {
  "id": 6,
  "start": 11.738,
  "end": 13.222,
  "text": "Ooh, can I see them?"
 },
 {
  "id": 7,
  "start": 13.42,
  "end": 14.46,
  "text": "Sure …"
 },
 {
  "id": 8,
  "start": 16.317,
  "end": 17.737,
  "text": "OK."
 },
 {
  "id": 9,
  "start": 17.899,
  "end": 20.169,
  "text": "This is my mother. She’s a teacher."
 },
 {
  "id": 10,
  "start": 20.371,
  "end": 22.688,
  "text": "Oh, yes. Nice picture!"
 },
 {
  "id": 11,
  "start": 22.926,
  "end": 25.998,
  "text": "And this one, this is my father."
 },
 {
  "id": 12,
  "start": 26.141,
  "end": 28.418,
  "text": "Oh, yes. Is he a teacher too?"
 },
 {
  "id": 13,
  "start": 28.593,
  "end": 29.894,
  "text": "No, he’s a manager."
 },
 {
  "id": 14,
  "start": 29.958,
  "end": 31.577,
  "text": "He works for a big supermarket."
 },
 {
  "id": 15,
  "start": 34.325,
  "end": 35.873,
  "text": "And who’s this?"
 },
 {
  "id": 16,
  "start": 36.262,
  "end": 37.928,
  "text": "This is my sister, Jackie."
 },
 {
  "id": 17,
  "start": 37.953,
  "end": 39.413,
  "text": "And her two girls."
 },
 {
  "id": 18,
  "start": 39.548,
  "end": 41.309,
  "text": "Oh, they’re beautiful."
 },
 {
  "id": 19,
  "start": 41.429,
  "end": 42.437,
  "text": "How old are they?"
 },
 {
  "id": 20,
  "start": 42.914,
  "end": 44.708,
  "text": "This is Kylie, she’s ten,"
 },
 {
  "id": 21,
  "start": 44.733,
  "end": 46.737,
  "text": "and this is Amanda, she’s eight."
 },
 {
  "id": 22,
  "start": 46.859,
  "end": 48.668,
  "text": "Oh. They’re lovely."
 },
 {
  "id": 23,
  "start": 49.294,
  "end": 50.897,
  "text": "Yes, they are …"
 },
 {
  "id": 24,
  "start": 51.573,
  "end": 52.803,
  "text": "So, what about you?"
 },
 {
  "id": 25,
  "start": 53.043,
  "end": 54.361,
  "text": "Do you have photos?"
 },
 {
  "id": 26,
  "start": 54.424,
  "end": 56.781,
  "text": "Yes, I do! Just a minute …"
 },
 {
  "id": 27,
  "start": 67.927,
  "end": 71.022,
  "text": "Ah, here we are."
 },
 {
  "id": 28,
  "start": 72.044,
  "end": 74.004,
  "text": "So …"
 },
 {
  "id": 29,
  "start": 74.669,
  "end": 76.709,
  "text": "this is Mike."
 },
 {
  "id": 30,
  "start": 77.741,
  "end": 78.979,
  "text": "Oh right."
 },
 {
  "id": 31,
  "start": 79.28,
  "end": 82.299,
  "text": "Who’s Mike? Is he your husband?"
 },
 {
  "id": 32,
  "start": 82.474,
  "end": 84.148,
  "text": "No, I’m not married!"
 },
 {
  "id": 33,
  "start": 84.66,
  "end": 85.85,
  "text": "He’s my brother."
 },
 {
  "id": 34,
  "start": 85.875,
  "end": 88.001,
  "text": "Oh! He looks nice."
 },
 {
  "id": 35,
  "start": 88.04,
  "end": 90.262,
  "text": "He is. He lives in Scotland."
 },
 {
  "id": 36,
  "start": 90.524,
  "end": 91.532,
  "text": "What’s his job?"
 },
 {
  "id": 37,
  "start": 91.587,
  "end": 93.032,
  "text": "He works with computers."
 },
 {
  "id": 38,
  "start": 93.071,
  "end": 93.976,
  "text": "OK."
 },
 {
  "id": 39,
  "start": 94.222,
  "end": 97.199,
  "text": "And this is Helen, his wife."
 },
 {
  "id": 40,
  "start": 97.366,
  "end": 99.842,
  "text": "She works in a hotel. She’s a manager."
 },
 {
  "id": 41,
  "start": 100.183,
  "end": 102.08,
  "text": "Ah. Nice photo."
 },
 {
  "id": 42,
  "start": 102.505,
  "end": 106.223,
  "text": "And this is James."
 },
 {
  "id": 43,
  "start": 106.493,
  "end": 108.985,
  "text": "He’s my cousin. He’s really great!"
 },
 {
  "id": 44,
  "start": 109.017,
  "end": 110.335,
  "text": "Oh, yes."
 },
 {
  "id": 45,
  "start": 112.038,
  "end": 113.467,
  "text": "James lives near you."
 },
 {
  "id": 46,
  "start": 113.816,
  "end": 115.8,
  "text": "Maybe we can go and see him?"
 },
 {
  "id": 47,
  "start": 116.388,
  "end": 118.229,
  "text": "Yes ... I’d like that."
 },
 {
  "id": 48,
  "start": 119.292,
  "end": 121.062,
  "text": "Thank you, Megan."
 }
]