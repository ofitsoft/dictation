[
 {
  "id": 1,
  "start": 0.46,
  "end": 2.508,
  "text": "Track 01.09"
 },
 {
  "id": 2,
  "start": 4.495,
  "end": 5.701,
  "text": "Tara"
 },
 {
  "id": 3,
  "start": 6.655,
  "end": 10.847,
  "text": "Last year, my ex-boyfriend told me he didn’t want to see me any more …"
 },
 {
  "id": 4,
  "start": 11.078,
  "end": 12.237,
  "text": "by text message!"
 },
 {
  "id": 5,
  "start": 12.779,
  "end": 14.414,
  "text": "What kind of person does that?"
 },
 {
  "id": 6,
  "start": 14.995,
  "end": 16.043,
  "text": "It was horrible."
 },
 {
  "id": 7,
  "start": 16.672,
  "end": 17.973,
  "text": "I called him for days,"
 },
 {
  "id": 8,
  "start": 17.998,
  "end": 19.021,
  "text": "but he didn’t answer."
 },
 {
  "id": 9,
  "start": 19.739,
  "end": 20.54,
  "text": "It made me feel like"
 },
 {
  "id": 10,
  "start": 20.565,
  "end": 22.143,
  "text": "I wasn’t important to him at all."
 },
 {
  "id": 11,
  "start": 22.93,
  "end": 25.049,
  "text": "I think he just wanted me to go away."
 },
 {
  "id": 12,
  "start": 25.716,
  "end": 26.644,
  "text": "What an idiot."
 },
 {
  "id": 13,
  "start": 28.195,
  "end": 29.299,
  "text": "Magda"
 },
 {
  "id": 14,
  "start": 30.0,
  "end": 33.142,
  "text": "When I want to plan something, I generally just send a text."
 },
 {
  "id": 15,
  "start": 33.859,
  "end": 35.676,
  "text": "It’s the same when I cancel plans –"
 },
 {
  "id": 16,
  "start": 36.295,
  "end": 37.676,
  "text": "a text message is easier."
 },
 {
  "id": 17,
  "start": 38.449,
  "end": 41.846,
  "text": "You don’t need to give a long explanation, you know, a lot of reasons."
 },
 {
  "id": 18,
  "start": 42.492,
  "end": 44.222,
  "text": "Or have a difficult conversation."
 },
 {
  "id": 19,
  "start": 44.825,
  "end": 46.095,
  "text": "It’s better for everyone."
 },
 {
  "id": 20,
  "start": 47.366,
  "end": 48.382,
  "text": "Chris"
 },
 {
  "id": 21,
  "start": 49.112,
  "end": 50.787,
  "text": "Birthdays are different now."
 },
 {
  "id": 22,
  "start": 51.129,
  "end": 57.027,
  "text": "I hardly ever get cards or presents from friends, or even my brother, and no one calls."
 },
 {
  "id": 23,
  "start": 57.332,
  "end": 60.824,
  "text": "Everyone just writes ‘Happy Birthday’ on my wall on Facebook."
 },
 {
  "id": 24,
  "start": 61.3,
  "end": 63.443,
  "text": "It’s not very friendly, in my opinion."
 },
 {
  "id": 25,
  "start": 64.963,
  "end": 66.018,
  "text": "Mike"
 },
 {
  "id": 26,
  "start": 66.569,
  "end": 69.982,
  "text": "My daughter is travelling around South America at the moment."
 },
 {
  "id": 27,
  "start": 70.508,
  "end": 71.635,
  "text": "She’s writing a blog"
 },
 {
  "id": 28,
  "start": 71.66,
  "end": 73.159,
  "text": "so we know what she’s doing."
 },
 {
  "id": 29,
  "start": 73.797,
  "end": 75.249,
  "text": "But she rarely calls."
 },
 {
  "id": 30,
  "start": 75.561,
  "end": 77.538,
  "text": "And I’d love to get a postcard"
 },
 {
  "id": 31,
  "start": 77.649,
  "end": 79.284,
  "text": "or a letter sometimes."
 },
 {
  "id": 32,
  "start": 79.818,
  "end": 82.032,
  "text": "Just to know she’s thinking about the family."
 }
]