[
 {
  "id": 1,
  "start": 0.508,
  "end": 2.508,
  "text": "Track 06.11"
 },
 {
  "id": 2,
  "start": 4.862,
  "end": 6.949,
  "text": "So, Aaron, your story is"
 },
 {
  "id": 3,
  "start": 6.974,
  "end": 8.227,
  "text": "pretty amazing."
 },
 {
  "id": 4,
  "start": 8.252,
  "end": 9.37,
  "text": "What happened to you?"
 },
 {
  "id": 5,
  "start": 9.395,
  "end": 11.056,
  "text": "Well, I think I’m very lucky"
 },
 {
  "id": 6,
  "start": 11.081,
  "end": 12.595,
  "text": "to be alive today."
 },
 {
  "id": 7,
  "start": 12.62,
  "end": 14.908,
  "text": "I was pulled along under a plane when we"
 },
 {
  "id": 8,
  "start": 14.933,
  "end": 17.734,
  "text": "were flying at a height of 6,000 metres."
 },
 {
  "id": 9,
  "start": 17.759,
  "end": 19.017,
  "text": "Wow!"
 },
 {
  "id": 10,
  "start": 19.042,
  "end": 20.629,
  "text": "That’s unbelievable!"
 },
 {
  "id": 11,
  "start": 20.654,
  "end": 21.86,
  "text": "How did it happen?"
 },
 {
  "id": 12,
  "start": 21.885,
  "end": 23.426,
  "text": "So there were three people"
 },
 {
  "id": 13,
  "start": 23.451,
  "end": 24.68,
  "text": "in the plane that day."
 },
 {
  "id": 14,
  "start": 24.705,
  "end": 26.635,
  "text": "Me and two other jumpers,"
 },
 {
  "id": 15,
  "start": 26.66,
  "end": 27.739,
  "text": "Monica and Ben."
 },
 {
  "id": 16,
  "start": 28.074,
  "end": 29.518,
  "text": "I wasn’t an experienced"
 },
 {
  "id": 17,
  "start": 29.543,
  "end": 31.14,
  "text": "parachute jumper at the time."
 },
 {
  "id": 18,
  "start": 31.165,
  "end": 33.474,
  "text": "I had only done about fifteen jumps."
 },
 {
  "id": 19,
  "start": 33.499,
  "end": 34.865,
  "text": "So, what went wrong?"
 },
 {
  "id": 20,
  "start": 34.89,
  "end": 35.486,
  "text": "Well…"
 },
 {
  "id": 21,
  "start": 35.511,
  "end": 37.44,
  "text": "Monica told me I should go first..."
 },
 {
  "id": 22,
  "start": 37.465,
  "end": 39.529,
  "text": "I stood up and put my foot outside the"
 },
 {
  "id": 23,
  "start": 39.554,
  "end": 40.435,
  "text": "plane door,"
 },
 {
  "id": 24,
  "start": 40.46,
  "end": 42.627,
  "text": "but then the wind pushed me to the side."
 },
 {
  "id": 25,
  "start": 42.652,
  "end": 43.765,
  "text": "I was stuck,"
 },
 {
  "id": 26,
  "start": 43.79,
  "end": 45.622,
  "text": "flat against the side of the plane."
 },
 {
  "id": 27,
  "start": 45.647,
  "end": 47.448,
  "text": "I tried to push myself away,"
 },
 {
  "id": 28,
  "start": 47.473,
  "end": 48.696,
  "text": "but it didn’t work."
 },
 {
  "id": 29,
  "start": 48.721,
  "end": 50.651,
  "text": "Then, part of my parachute"
 },
 {
  "id": 30,
  "start": 50.676,
  "end": 51.939,
  "text": "got stuck on the plane,"
 },
 {
  "id": 31,
  "start": 51.964,
  "end": 53.059,
  "text": "I couldn’t move my leg"
 },
 {
  "id": 32,
  "start": 53.084,
  "end": 54.417,
  "text": "so I couldn’t fall."
 },
 {
  "id": 33,
  "start": 54.442,
  "end": 56.237,
  "text": "I was hanging under the plane,"
 },
 {
  "id": 34,
  "start": 56.262,
  "end": 57.771,
  "text": "hanging from my parachute,"
 },
 {
  "id": 35,
  "start": 57.796,
  "end": 59.487,
  "text": "and there was nothing I could do."
 },
 {
  "id": 36,
  "start": 59.512,
  "end": 61.132,
  "text": "The others couldn’t see me."
 },
 {
  "id": 37,
  "start": 61.157,
  "end": 62.165,
  "text": "The plane was just"
 },
 {
  "id": 38,
  "start": 62.19,
  "end": 63.777,
  "text": "pulling me along in the sky"
 },
 {
  "id": 39,
  "start": 63.802,
  "end": 65.461,
  "text": "and nobody knew I was there."
 },
 {
  "id": 40,
  "start": 65.486,
  "end": 67.4,
  "text": "That sounds terrifying!"
 },
 {
  "id": 41,
  "start": 67.425,
  "end": 68.648,
  "text": "How did you feel?"
 },
 {
  "id": 42,
  "start": 68.673,
  "end": 70.538,
  "text": "Obviously, I was very frightened."
 },
 {
  "id": 43,
  "start": 70.563,
  "end": 72.233,
  "text": "I knew how dangerous it was."
 },
 {
  "id": 44,
  "start": 72.258,
  "end": 73.409,
  "text": "I knew I could die"
 },
 {
  "id": 45,
  "start": 73.434,
  "end": 74.671,
  "text": "if I hit the the back of the plane."
 },
 {
  "id": 46,
  "start": 74.696,
  "end": 76.602,
  "text": "So did the others help you?"
 },
 {
  "id": 47,
  "start": 76.627,
  "end": 77.602,
  "text": "At first,"
 },
 {
  "id": 48,
  "start": 77.627,
  "end": 78.841,
  "text": "they didn’t know I was there."
 },
 {
  "id": 49,
  "start": 78.866,
  "end": 80.454,
  "text": "But when Monica was getting ready to"
 },
 {
  "id": 50,
  "start": 80.479,
  "end": 82.019,
  "text": "jump, she saw me and shouted,"
 },
 {
  "id": 51,
  "start": 82.044,
  "end": 84.425,
  "text": "‘Aaron’s under the plane!’"
 },
 {
  "id": 52,
  "start": 84.45,
  "end": 86.666,
  "text": "The pilot slowed the plane down"
 },
 {
  "id": 53,
  "start": 86.691,
  "end": 88.477,
  "text": "and they freed my parachute."
 },
 {
  "id": 54,
  "start": 88.502,
  "end": 91.186,
  "text": "When I started to fall, I felt better,"
 },
 {
  "id": 55,
  "start": 91.211,
  "end": 92.76,
  "text": "but when I landed I was shocked to"
 },
 {
  "id": 56,
  "start": 92.785,
  "end": 94.404,
  "text": "think about what had happened."
 },
 {
  "id": 57,
  "start": 94.429,
  "end": 96.01,
  "text": "Did that experience stop"
 },
 {
  "id": 58,
  "start": 96.035,
  "end": 97.082,
  "text": "you from jumping?"
 },
 {
  "id": 59,
  "start": 97.107,
  "end": 98.791,
  "text": "No, but I realised"
 },
 {
  "id": 60,
  "start": 98.816,
  "end": 100.085,
  "text": "how serious it was."
 },
 {
  "id": 61,
  "start": 100.11,
  "end": 101.555,
  "text": "Because I jumped first,"
 },
 {
  "id": 62,
  "start": 101.58,
  "end": 103.439,
  "text": "Monica saw me and saved me,"
 },
 {
  "id": 63,
  "start": 103.464,
  "end": 105.387,
  "text": "but if I had been the last one to jump,"
 },
 {
  "id": 64,
  "start": 105.412,
  "end": 106.499,
  "text": "I would have died"
 },
 {
  "id": 65,
  "start": 106.524,
  "end": 108.237,
  "text": "because the pilot could not have saved"
 },
 {
  "id": 66,
  "start": 108.262,
  "end": 109.999,
  "text": "me while he was flying the plane."
 }
]