[
 {
  "id": 1,
  "start": 0.669,
  "end": 2.534,
  "text": "Track 12.06"
 },
 {
  "id": 2,
  "start": 5.021,
  "end": 7.037,
  "text": "1 Claire"
 },
 {
  "id": 3,
  "start": 7.994,
  "end": 8.811,
  "text": "My little sister"
 },
 {
  "id": 4,
  "start": 8.86,
  "end": 11.503,
  "text": "and I have always had our fights."
 },
 {
  "id": 5,
  "start": 11.792,
  "end": 13.316,
  "text": "I think the funniest time"
 },
 {
  "id": 6,
  "start": 13.341,
  "end": 15.237,
  "text": "was when I made her ride a cow."
 },
 {
  "id": 7,
  "start": 15.906,
  "end": 17.898,
  "text": "We lived in a house with a field of"
 },
 {
  "id": 8,
  "start": 17.923,
  "end": 19.153,
  "text": "of cows on one side and"
 },
 {
  "id": 9,
  "start": 19.616,
  "end": 22.076,
  "text": "and I told my sister that they were horses."
 },
 {
  "id": 10,
  "start": 22.653,
  "end": 24.803,
  "text": "I went into the field and stood behind the"
 },
 {
  "id": 11,
  "start": 24.828,
  "end": 26.955,
  "text": "cows making horse noises."
 },
 {
  "id": 12,
  "start": 27.625,
  "end": 29.252,
  "text": "When the cows were right"
 },
 {
  "id": 13,
  "start": 29.318,
  "end": 30.81,
  "text": "next to our garden fence,"
 },
 {
  "id": 14,
  "start": 30.993,
  "end": 33.032,
  "text": "I said she could ride one of the horses …"
 },
 {
  "id": 15,
  "start": 33.328,
  "end": 34.693,
  "text": "just like a cowboy!"
 },
 {
  "id": 16,
  "start": 35.346,
  "end": 37.299,
  "text": "I still can’t believe she listened to me!"
 },
 {
  "id": 17,
  "start": 37.937,
  "end": 38.31,
  "text": "She just"
 },
 {
  "id": 18,
  "start": 38.59,
  "end": 41.066,
  "text": "jumped off the fence onto a cow’s back!"
 },
 {
  "id": 19,
  "start": 41.759,
  "end": 44.132,
  "text": "The cow was very surprised."
 },
 {
  "id": 20,
  "start": 44.627,
  "end": 46.555,
  "text": "It ran away with my sister"
 },
 {
  "id": 21,
  "start": 46.58,
  "end": 48.256,
  "text": "holding onto its back."
 },
 {
  "id": 22,
  "start": 48.606,
  "end": 50.344,
  "text": "I couldn’t stop laughing."
 },
 {
  "id": 23,
  "start": 50.998,
  "end": 51.673,
  "text": "In the end,"
 },
 {
  "id": 24,
  "start": 51.99,
  "end": 53.387,
  "text": "my sister fell off."
 },
 {
  "id": 25,
  "start": 53.906,
  "end": 55.962,
  "text": "Her clothes were really dirty"
 },
 {
  "id": 26,
  "start": 56.082,
  "end": 57.257,
  "text": "and she was crying."
 },
 {
  "id": 27,
  "start": 58.102,
  "end": 60.903,
  "text": "Then I felt bad and helped her back home."
 },
 {
  "id": 28,
  "start": 61.747,
  "end": 62.636,
  "text": "When we got back,"
 },
 {
  "id": 29,
  "start": 63.027,
  "end": 64.939,
  "text": "I told my mum my sister had tried"
 },
 {
  "id": 30,
  "start": 64.964,
  "end": 65.932,
  "text": "to ride a cow"
 },
 {
  "id": 31,
  "start": 66.26,
  "end": 67.736,
  "text": "and I had saved her."
 },
 {
  "id": 32,
  "start": 68.373,
  "end": 69.461,
  "text": "She believed me …"
 },
 {
  "id": 33,
  "start": 70.319,
  "end": 71.653,
  "text": "I still feel guilty."
 },
 {
  "id": 34,
  "start": 73.624,
  "end": 75.497,
  "text": "2 Jeremy"
 },
 {
  "id": 35,
  "start": 76.367,
  "end": 78.732,
  "text": "I often used to play with my younger brother,"
 },
 {
  "id": 36,
  "start": 79.02,
  "end": 80.941,
  "text": "but we did fight a lot, too."
 },
 {
  "id": 37,
  "start": 81.674,
  "end": 83.144,
  "text": "I remember one time"
 },
 {
  "id": 38,
  "start": 83.169,
  "end": 84.645,
  "text": "when I was really mean to him."
 },
 {
  "id": 39,
  "start": 85.277,
  "end": 86.764,
  "text": "That day my parents had"
 },
 {
  "id": 40,
  "start": 86.836,
  "end": 87.768,
  "text": "burnt some leaves"
 },
 {
  "id": 41,
  "start": 87.793,
  "end": 88.492,
  "text": "in the garden"
 },
 {
  "id": 42,
  "start": 88.835,
  "end": 90.708,
  "text": "and the fire was still a bit hot."
 },
 {
  "id": 43,
  "start": 91.41,
  "end": 93.283,
  "text": "So I had an idea for a joke"
 },
 {
  "id": 44,
  "start": 93.403,
  "end": 94.626,
  "text": "to play on my brother."
 },
 {
  "id": 45,
  "start": 95.397,
  "end": 97.477,
  "text": "We had an old kettle in the garden."
 },
 {
  "id": 46,
  "start": 97.772,
  "end": 99.265,
  "text": "It was really dirty."
 },
 {
  "id": 47,
  "start": 100.197,
  "end": 101.141,
  "text": "I told my brother"
 },
 {
  "id": 48,
  "start": 101.189,
  "end": 103.625,
  "text": "I was going to make ‘grass soup’."
 },
 {
  "id": 49,
  "start": 104.717,
  "end": 106.582,
  "text": "So I took some grass"
 },
 {
  "id": 50,
  "start": 106.64,
  "end": 108.926,
  "text": "and put it in the dirty old kettle"
 },
 {
  "id": 51,
  "start": 109.015,
  "end": 110.03,
  "text": "with some water."
 },
 {
  "id": 52,
  "start": 110.882,
  "end": 112.684,
  "text": "I put it on the fire for a minute."
 },
 {
  "id": 53,
  "start": 113.162,
  "end": 115.504,
  "text": "Then I poured some into a cup"
 },
 {
  "id": 54,
  "start": 115.696,
  "end": 117.029,
  "text": "and gave it to my brother."
 },
 {
  "id": 55,
  "start": 117.668,
  "end": 118.89,
  "text": "It was a horrible"
 },
 {
  "id": 56,
  "start": 119.097,
  "end": 120.502,
  "text": "brown-orange colour"
 },
 {
  "id": 57,
  "start": 120.727,
  "end": 122.655,
  "text": "with green bits of grass in it."
 },
 {
  "id": 58,
  "start": 123.467,
  "end": 125.959,
  "text": "He didn’t look very sure about drinking it,"
 },
 {
  "id": 59,
  "start": 126.232,
  "end": 128.367,
  "text": "so I put the cup near my mouth"
 },
 {
  "id": 60,
  "start": 128.6,
  "end": 130.473,
  "text": "and told him I had drunk some"
 },
 {
  "id": 61,
  "start": 130.498,
  "end": 131.705,
  "text": "and it was delicious."
 },
 {
  "id": 62,
  "start": 132.342,
  "end": 134.509,
  "text": "I hadn’t even tasted it, of course."
 },
 {
  "id": 63,
  "start": 135.393,
  "end": 136.496,
  "text": "I gave him the cup"
 },
 {
  "id": 64,
  "start": 136.695,
  "end": 138.528,
  "text": "and he drank all of it."
 },
 {
  "id": 65,
  "start": 139.206,
  "end": 140.444,
  "text": "Later that evening,"
 },
 {
  "id": 66,
  "start": 140.532,
  "end": 142.841,
  "text": "my brother said he wasn’t feeling very well."
 },
 {
  "id": 67,
  "start": 143.664,
  "end": 146.902,
  "text": "My parents wanted to know why, so, really,"
 },
 {
  "id": 68,
  "start": 147.119,
  "end": 149.222,
  "text": "I had to tell them about my ‘soup’."
 },
 {
  "id": 69,
  "start": 151.1,
  "end": 153.14,
  "text": "3 Tanya"
 },
 {
  "id": 70,
  "start": 153.993,
  "end": 156.152,
  "text": "My sister’s a year and a half older than me"
 },
 {
  "id": 71,
  "start": 156.693,
  "end": 157.82,
  "text": "and we always got on well."
 },
 {
  "id": 72,
  "start": 158.728,
  "end": 159.482,
  "text": "When we were little,"
 },
 {
  "id": 73,
  "start": 159.84,
  "end": 160.872,
  "text": "we were very similar"
 },
 {
  "id": 74,
  "start": 161.015,
  "end": 162.221,
  "text": "and did everything together."
 },
 {
  "id": 75,
  "start": 163.049,
  "end": 165.041,
  "text": "But then she started to read a lot,"
 },
 {
  "id": 76,
  "start": 165.464,
  "end": 167.218,
  "text": "and she was very strong for her age."
 },
 {
  "id": 77,
  "start": 168.061,
  "end": 168.894,
  "text": "I didn’t mind,"
 },
 {
  "id": 78,
  "start": 169.491,
  "end": 170.562,
  "text": "but I didn’t like the attention"
 },
 {
  "id": 79,
  "start": 170.587,
  "end": 171.832,
  "text": "she got from my parents."
 },
 {
  "id": 80,
  "start": 172.94,
  "end": 173.488,
  "text": "One day"
 },
 {
  "id": 81,
  "start": 173.869,
  "end": 174.329,
  "text": "some of my"
 },
 {
  "id": 82,
  "start": 174.354,
  "end": 176.051,
  "text": "parents’ friends came to visit us."
 },
 {
  "id": 83,
  "start": 176.985,
  "end": 179.39,
  "text": "My dad told them he was very proud of my sister,"
 },
 {
  "id": 84,
  "start": 179.853,
  "end": 181.195,
  "text": "because she could read so well."
 },
 {
  "id": 85,
  "start": 182.132,
  "end": 183.362,
  "text": "I got really angry,"
 },
 {
  "id": 86,
  "start": 183.834,
  "end": 185.437,
  "text": "so I went to the bookcase in the hall"
 },
 {
  "id": 87,
  "start": 185.732,
  "end": 187.51,
  "text": "and chose five of the biggest,"
 },
 {
  "id": 88,
  "start": 187.581,
  "end": 188.994,
  "text": "thickest books I could see."
 },
 {
  "id": 89,
  "start": 190.006,
  "end": 190.363,
  "text": "Then"
 },
 {
  "id": 90,
  "start": 190.618,
  "end": 192.817,
  "text": "I went back to my parents and their friends"
 },
 {
  "id": 91,
  "start": 193.066,
  "end": 195.288,
  "text": "and said I had just finished reading the books."
 },
 {
  "id": 92,
  "start": 196.172,
  "end": 198.458,
  "text": "My dad asked me to describe the stories."
 },
 {
  "id": 93,
  "start": 199.032,
  "end": 200.032,
  "text": "I had no idea,"
 },
 {
  "id": 94,
  "start": 200.517,
  "end": 201.072,
  "text": "so I just"
 },
 {
  "id": 95,
  "start": 201.485,
  "end": 202.588,
  "text": "looked at the front of the books"
 },
 {
  "id": 96,
  "start": 202.613,
  "end": 203.52,
  "text": "and guessed."
 },
 {
  "id": 97,
  "start": 204.197,
  "end": 207.538,
  "text": "So I talked about a happy king with lots of rings-"
 },
 {
  "id": 98,
  "start": 207.833,
  "end": 208.889,
  "text": "that was Lord of the Rings-"
 },
 {
  "id": 99,
  "start": 209.455,
  "end": 211.503,
  "text": "and also lots of stories about people"
 },
 {
  "id": 100,
  "start": 211.559,
  "end": 213.043,
  "text": "with names beginning with N."
 },
 {
  "id": 101,
  "start": 213.706,
  "end": 216.214,
  "text": "That was volume 12 of an encyclopedia."
 },
 {
  "id": 102,
  "start": 217.051,
  "end": 218.367,
  "text": "I could hear my sister laughing"
 },
 {
  "id": 103,
  "start": 218.392,
  "end": 219.924,
  "text": "in the other room the whole time."
 }
]