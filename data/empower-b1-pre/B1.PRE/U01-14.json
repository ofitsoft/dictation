  "text": "Track 01.14"
 },
 {
  "id": 2,
  "start": 4.67,
  "end": 5.679,
  "text": "PART 1"
 },
 {
  "id": 3,
  "start": 15.216,
  "end": 16.169,
  "text": "Annie?"
 },
 {
  "id": 4,
  "start": 17.561,
  "end": 18.814,
  "text": "Rachel!"
 },
 {
  "id": 5,
  "start": 18.951,
  "end": 20.712,
  "text": "Long time no see! How are you?"
 },
 {
  "id": 6,
  "start": 20.737,
  "end": 21.706,
  "text": "I’m great."
 },
 {
  "id": 7,
  "start": 22.142,
  "end": 23.698,
  "text": "What a lovely surprise!"
 },
 {
  "id": 8,
  "start": 23.826,
  "end": 24.746,
  "text": "Great to see you!"
 },
 {
  "id": 9,
  "start": 24.771,
  "end": 25.922,
  "text": "Yeah! You too."
 },
 {
  "id": 10,
  "start": 26.066,
  "end": 27.597,
  "text": "When did we last see each other?"
 },
 {
  "id": 11,
  "start": 27.98,
  "end": 29.599,
  "text": "Oh, I think it was about …"
 },
 {
  "id": 12,
  "start": 30.068,
  "end": 31.242,
  "text": "six years ago!"
 },
 {
  "id": 13,
  "start": 32.276,
  "end": 33.839,
  "text": "So … where are you living these days?"
 },
 {
  "id": 14,
  "start": 33.864,
  "end": 35.093,
  "text": "Oh, not far from here."
 },
 {
  "id": 15,
  "start": 35.332,
  "end": 36.808,
  "text": "I live on Hampton Street."
 },
 {
  "id": 16,
  "start": 37.007,
  "end": 37.856,
  "text": "Do you know it?"
 },
 {
  "id": 17,
  "start": 38.144,
  "end": 39.175,
  "text": "Yes, I do."
 },
 {
  "id": 18,
  "start": 39.2,
  "end": 40.461,
  "text": "That’s really close to the centre."
 },
 {
  "id": 19,
  "start": 40.495,
  "end": 41.813,
  "text": "Mmm. How about you?"
 },
 {
  "id": 20,
  "start": 42.028,
  "end": 43.417,
  "text": "We live on Compton Road."
 },
 {
  "id": 21,
  "start": 43.568,
  "end": 45.083,
  "text": "Oh – how nice!"
 },
 {
  "id": 22,
  "start": 45.291,
  "end": 46.474,
  "text": "My name’s Mark, by the way."
 },
 {
  "id": 23,
  "start": 46.585,
  "end": 47.743,
  "text": "Hi. Nice to meet you."
 },
 {
  "id": 24,
  "start": 47.768,
  "end": 48.848,
  "text": "Nice to meet you, too."
 },
 {
  "id": 25,
  "start": 49.03,
  "end": 51.466,
  "text": "Sorry, yes – Mark’s my husband!"
 },
 {
  "id": 26,
  "start": 51.675,
  "end": 53.175,
  "text": "Husband – wow!"
 },
 {
  "id": 27,
  "start": 53.333,
  "end": 54.667,
  "text": "That’s fantastic news."
 },
 {
  "id": 28,
  "start": 55.087,
  "end": 56.191,
  "text": "When did you get married?"
 },
 {
  "id": 29,
  "start": 56.278,
  "end": 56.881,
  "text": "Six months ago."
 },
 {
  "id": 30,
  "start": 56.906,
  "end": 57.524,
  "text": "Eight months ago."
 },
 {
  "id": 31,
  "start": 59.185,
  "end": 60.828,
  "text": "It was six, Mark."
 },
 {
  "id": 32,
  "start": 62.663,
  "end": 64.527,
  "text": "Well, congratulations!"
 },
 {
  "id": 33,
  "start": 65.103,
  "end": 66.873,
  "text": "I want to know all the details!"
 },
 {
  "id": 34,
  "start": 67.725,
  "end": 72.013,
  "text": "Look – I’m going to the café down the street now to meet Leo, my boyfriend."
 },
 {
  "id": 35,
  "start": 72.592,
  "end": 73.997,
  "text": "Would you both like to come?"
 },
 {
  "id": 36,
  "start": 75.769,
  "end": 77.102,
  "text": "Yeah, that sounds good."
 },
 {
  "id": 37,
  "start": 77.159,
  "end": 79.215,
  "text": "Brilliant! Let’s go."
 }
]