[
 {
  "id": 1,
  "start": 0.468,
  "end": 2.349,
  "text": "Track 03.02"
 },
 {
  "id": 2,
  "start": 4.447,
  "end": 5.891,
  "text": "So, Janie."
 },
 {
  "id": 3,
  "start": 6.171,
  "end": 8.67,
  "text": "You’re in town for us for the"
 },
 {
  "id": 4,
  "start": 8.695,
  "end": 10.893,
  "text": "Black Friday sales season."
 },
 {
  "id": 5,
  "start": 11.293,
  "end": 12.388,
  "text": "How’s it going?"
 },
 {
  "id": 6,
  "start": 12.637,
  "end": 13.891,
  "text": "Yes, Harry."
 },
 {
  "id": 7,
  "start": 14.202,
  "end": 17.13,
  "text": "I’m here at the City Arcade and"
 },
 {
  "id": 8,
  "start": 17.155,
  "end": 19.877,
  "text": "it is busy, busy, busy!"
 },
 {
  "id": 9,
  "start": 20.3,
  "end": 22.864,
  "text": "I’m joined by two people who know"
 },
 {
  "id": 10,
  "start": 22.968,
  "end": 24.191,
  "text": "all about that:"
 },
 {
  "id": 11,
  "start": 24.534,
  "end": 27.455,
  "text": "shop assistants Mike and Kathie."
 },
 {
  "id": 12,
  "start": 27.894,
  "end": 30.323,
  "text": "Mike, tell me about your day –"
 },
 {
  "id": 13,
  "start": 30.443,
  "end": 31.896,
  "text": "have you been busy?"
 },
 {
  "id": 14,
  "start": 32.112,
  "end": 33.644,
  "text": "Yeah – crazy."
 },
 {
  "id": 15,
  "start": 34.392,
  "end": 37.043,
  "text": "I think this is the busiest sales day we’ve ever had."
 },
 {
  "id": 16,
  "start": 37.721,
  "end": 39.705,
  "text": "I’ve never seen crowds like this"
 },
 {
  "id": 17,
  "start": 39.747,
  "end": 43.072,
  "text": "and I’ve worked on sales days three times before."
 },
 {
  "id": 18,
  "start": 43.334,
  "end": 44.779,
  "text": "Like, this morning"
 },
 {
  "id": 19,
  "start": 44.969,
  "end": 46.723,
  "text": "just before we opened the doors -"
 },
 {
  "id": 20,
  "start": 46.995,
  "end": 48.312,
  "text": "there was this young guy"
 },
 {
  "id": 21,
  "start": 48.337,
  "end": 49.844,
  "text": "right at the front of the queue."
 },
 {
  "id": 22,
  "start": 50.3,
  "end": 51.95,
  "text": "I asked him when he got there,"
 },
 {
  "id": 23,
  "start": 52.103,
  "end": 54.333,
  "text": "and he said 7 o’clock last night."
 },
 {
  "id": 24,
  "start": 54.494,
  "end": 57.105,
  "text": "Wow – so he waited"
 },
 {
  "id": 25,
  "start": 57.131,
  "end": 59.321,
  "text": "thirteen hours in the cold?"
 },
 {
  "id": 26,
  "start": 59.855,
  "end": 61.419,
  "text": "Why the big wait?"
 },
 {
  "id": 27,
  "start": 61.532,
  "end": 63.452,
  "text": "Well, that’s the thing –"
 },
 {
  "id": 28,
  "start": 63.627,
  "end": 64.96,
  "text": "when the doors opened,"
 },
 {
  "id": 29,
  "start": 65.169,
  "end": 67.939,
  "text": "I saw that he went to buy a one-pound T-shirt."
 },
 {
  "id": 30,
  "start": 68.137,
  "end": 68.965,
  "text": "And that was all."
 },
 {
  "id": 31,
  "start": 68.99,
  "end": 70.053,
  "text": "Really?"
 },
 {
  "id": 32,
  "start": 70.235,
  "end": 73.412,
  "text": "No TV or computer or anything?"
 },
 {
  "id": 33,
  "start": 73.501,
  "end": 74.199,
  "text": "No –"
 },
 {
  "id": 34,
  "start": 74.406,
  "end": 76.906,
  "text": "thirteen hours for a one-pound T-shirt –"
 },
 {
  "id": 35,
  "start": 77.034,
  "end": 78.081,
  "text": "just crazy!"
 },
 {
  "id": 36,
  "start": 78.549,
  "end": 80.462,
  "text": "I’ve never known someone to do that."
 },
 {
  "id": 37,
  "start": 80.671,
  "end": 82.592,
  "text": "How about you, Kathie?"
 },
 {
  "id": 38,
  "start": 82.854,
  "end": 84.615,
  "text": "Any funny stories?"
 },
 {
  "id": 39,
  "start": 84.992,
  "end": 86.111,
  "text": "Tons!"
 },
 {
  "id": 40,
  "start": 86.604,
  "end": 89.318,
  "text": "I’ve never worked on a sales day before,"
 },
 {
  "id": 41,
  "start": 89.669,
  "end": 92.128,
  "text": "and I didn’t know it was like this."
 },
 {
  "id": 42,
  "start": 92.542,
  "end": 94.875,
  "text": "Like, there was this one lady."
 },
 {
  "id": 43,
  "start": 94.956,
  "end": 96.861,
  "text": "She’s probably the cleverest"
 },
 {
  "id": 44,
  "start": 96.886,
  "end": 98.401,
  "text": "customer I’ve ever met."
 },
 {
  "id": 45,
  "start": 98.435,
  "end": 100.363,
  "text": "Did she get a good bargain?"
 },
 {
  "id": 46,
  "start": 101.31,
  "end": 102.81,
  "text": "It wasn’t that."
 },
 {
  "id": 47,
  "start": 102.994,
  "end": 105.034,
  "text": "She was a little old lady."
 },
 {
  "id": 48,
  "start": 105.226,
  "end": 107.623,
  "text": "I saw her and I thought she looked unwell."
 },
 {
  "id": 49,
  "start": 107.943,
  "end": 111.213,
  "text": "So I got her a chair so she could sit down."
 },
 {
  "id": 50,
  "start": 111.572,
  "end": 115.374,
  "text": "And she asked me if I could get her a towel that she wanted to buy,"
 },
 {
  "id": 51,
  "start": 115.631,
  "end": 117.234,
  "text": "and put it in her shopping basket."
 },
 {
  "id": 52,
  "start": 117.545,
  "end": 119.513,
  "text": "And then she asked me to get her"
 },
 {
  "id": 53,
  "start": 119.538,
  "end": 122.752,
  "text": "four cups that cost 50 pence each …"
 },
 {
  "id": 54,
  "start": 122.882,
  "end": 124.334,
  "text": "I was really busy,"
 },
 {
  "id": 55,
  "start": 124.359,
  "end": 125.921,
  "text": "but I got these things for her."
 },
 {
  "id": 56,
  "start": 125.946,
  "end": 127.446,
  "text": "Very kind."
 },
 {
  "id": 57,
  "start": 127.901,
  "end": 130.847,
  "text": "And then there was a shop announcement –"
 },
 {
  "id": 58,
  "start": 131.055,
  "end": 134.475,
  "text": "‘tablet computers just £75!’"
 },
 {
  "id": 59,
  "start": 134.652,
  "end": 137.796,
  "text": "And she jumped up and ran to the electronics department."
 },
 {
  "id": 60,
  "start": 137.821,
  "end": 140.06,
  "text": "So much for feeling unwell …"
 },
 {
  "id": 61,
  "start": 140.188,
  "end": 142.505,
  "text": "Oh yes, she was fine!"
 },
 {
  "id": 62,
  "start": 142.586,
  "end": 144.11,
  "text": "And very clever –"
 },
 {
  "id": 63,
  "start": 144.461,
  "end": 146.516,
  "text": "she made me do her shopping for her!"
 },
 {
  "id": 64,
  "start": 146.614,
  "end": 148.709,
  "text": "Oh, and I remember …"
 },
 {
  "id": 65,
  "start": 148.933,
  "end": 150.488,
  "text": "there was this one guy."
 },
 {
  "id": 66,
  "start": 150.664,
  "end": 153.355,
  "text": "He wanted these really expensive jeans –"
 },
 {
  "id": 67,
  "start": 153.769,
  "end": 154.928,
  "text": "there were five"
 },
 {
  "id": 68,
  "start": 154.953,
  "end": 157.572,
  "text": "pairs for sale at just £25 –"
 },
 {
  "id": 69,
  "start": 157.852,
  "end": 159.987,
  "text": "a saving of £100."
 },
 {
  "id": 70,
  "start": 160.155,
  "end": 163.592,
  "text": "So he started queuing at about midnight last night"
 },
 {
  "id": 71,
  "start": 163.822,
  "end": 165.338,
  "text": "and waited eight hours."
 },
 {
  "id": 72,
  "start": 165.483,
  "end": 167.531,
  "text": "I’m sure he wasn’t alone."
 },
 {
  "id": 73,
  "start": 167.556,
  "end": 168.69,
  "text": "Well, no."
 },
 {
  "id": 74,
  "start": 169.016,
  "end": 171.622,
  "text": "So anyway, the doors opened"
 },
 {
  "id": 75,
  "start": 171.653,
  "end": 174.027,
  "text": "and he ran to the menswear department,"
 },
 {
  "id": 76,
  "start": 174.211,
  "end": 175.799,
  "text": "but they were all gone."
 },
 {
  "id": 77,
  "start": 175.856,
  "end": 177.347,
  "text": "How did that happen?"
 },
 {
  "id": 78,
  "start": 177.372,
  "end": 179.651,
  "text": "Well, he queued at the main door,"
 },
 {
  "id": 79,
  "start": 179.874,
  "end": 181.635,
  "text": "but there’s another door into the shop"
 },
 {
  "id": 80,
  "start": 181.667,
  "end": 184.255,
  "text": "that is very close to the menswear department –"
 },
 {
  "id": 81,
  "start": 184.503,
  "end": 186.304,
  "text": "so five other people"
 },
 {
  "id": 82,
  "start": 186.329,
  "end": 187.328,
  "text": "got there before him."
 },
 {
  "id": 83,
  "start": 187.41,
  "end": 189.814,
  "text": "After waiting eight hours."
 },
 {
  "id": 84,
  "start": 190.006,
  "end": 193.079,
  "text": "Yeah – he had the saddest face I’ve ever seen."
 }
]