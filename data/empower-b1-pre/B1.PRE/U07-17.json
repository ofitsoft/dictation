[
 {
  "id": 1,
  "start": 0.524,
  "end": 2.849,
  "text": "Track 07.17"
 },
 {
  "id": 2,
  "start": 5.06,
  "end": 7.337,
  "text": "My name’s Jenny Jackson"
 },
 {
  "id": 3,
  "start": 7.362,
  "end": 9.441,
  "text": "and today we’re talking about"
 },
 {
  "id": 4,
  "start": 9.466,
  "end": 11.307,
  "text": "how to change your life."
 },
 {
  "id": 5,
  "start": 11.811,
  "end": 13.954,
  "text": "In the studio with us today,"
 },
 {
  "id": 6,
  "start": 13.979,
  "end": 16.154,
  "text": "we have three people who have made"
 },
 {
  "id": 7,
  "start": 16.179,
  "end": 18.029,
  "text": "changes in their lives:"
 },
 {
  "id": 8,
  "start": 18.054,
  "end": 20.976,
  "text": "Jeff, Silvia and Lucas."
 },
 {
  "id": 9,
  "start": 21.001,
  "end": 23.742,
  "text": "Hi guys, welcome to the show."
 },
 {
  "id": 10,
  "start": 23.767,
  "end": 24.974,
  "text": "Hi."
 },
 {
  "id": 11,
  "start": 25.43,
  "end": 27.762,
  "text": "So first of all Jeff."
 },
 {
  "id": 12,
  "start": 28.249,
  "end": 30.304,
  "text": "Can you tell us what your problem was?"
 },
 {
  "id": 13,
  "start": 30.664,
  "end": 33.092,
  "text": "Why did you need to make a change?"
 },
 {
  "id": 14,
  "start": 33.571,
  "end": 36.105,
  "text": "Well, one day I suddenly realised that"
 },
 {
  "id": 15,
  "start": 36.106,
  "end": 37.929,
  "text": "if I wanted to buy a new car"
 },
 {
  "id": 16,
  "start": 38.171,
  "end": 39.471,
  "text": "or my own apartment,"
 },
 {
  "id": 17,
  "start": 39.673,
  "end": 41.38,
  "text": "I needed to save some money."
 },
 {
  "id": 18,
  "start": 41.405,
  "end": 42.217,
  "text": "I see."
 },
 {
  "id": 19,
  "start": 42.98,
  "end": 44.845,
  "text": "Why didn’t you have any money?"
 },
 {
  "id": 20,
  "start": 45.063,
  "end": 47.706,
  "text": "Well, I used to spend a lot of money on"
 },
 {
  "id": 21,
  "start": 47.707,
  "end": 49.376,
  "text": "things that I didn’t really need."
 },
 {
  "id": 22,
  "start": 49.556,
  "end": 51.053,
  "text": "So, for example,"
 },
 {
  "id": 23,
  "start": 51.185,
  "end": 52.726,
  "text": "I used to go out for dinner at a"
 },
 {
  "id": 24,
  "start": 52.727,
  "end": 54.706,
  "text": "restaurant at least four times a week."
 },
 {
  "id": 25,
  "start": 55.085,
  "end": 56.945,
  "text": "I loved getting new things –"
 },
 {
  "id": 26,
  "start": 56.97,
  "end": 59.018,
  "text": "like, you know, the latest phone,"
 },
 {
  "id": 27,
  "start": 59.043,
  "end": 60.129,
  "text": "clothes…."
 },
 {
  "id": 28,
  "start": 60.154,
  "end": 61.53,
  "text": "One weekend I sat down"
 },
 {
  "id": 29,
  "start": 61.555,
  "end": 65.133,
  "text": "and added up the money I had spent in a month... I was shocked."
 },
 {
  "id": 30,
  "start": 65.199,
  "end": 66.748,
  "text": "I can imagine."
 },
 {
  "id": 31,
  "start": 67.369,
  "end": 69.468,
  "text": "So what have you changed?"
 },
 {
  "id": 32,
  "start": 69.731,
  "end": 71.73,
  "text": "Well, now I eat at home"
 },
 {
  "id": 33,
  "start": 71.755,
  "end": 72.643,
  "text": "most of the time."
 },
 {
  "id": 34,
  "start": 72.986,
  "end": 75.377,
  "text": "And I think, ‘Do I need this?’"
 },
 {
  "id": 35,
  "start": 75.378,
  "end": 77.112,
  "text": "before I buy something new."
 },
 {
  "id": 36,
  "start": 77.485,
  "end": 80.659,
  "text": "I’ve saved almost £5,000."
 },
 {
  "id": 37,
  "start": 80.868,
  "end": 82.693,
  "text": "I’m really pleased with myself."
 },
 {
  "id": 38,
  "start": 82.718,
  "end": 84.282,
  "text": "Cool. That’s great."
 },
 {
  "id": 39,
  "start": 85.061,
  "end": 87.34,
  "text": "Next up we have Silvia."
 },
 {
  "id": 40,
  "start": 88.042,
  "end": 90.598,
  "text": "Silvia, tell us about your change."
 },
 {
  "id": 41,
  "start": 90.623,
  "end": 91.608,
  "text": "Hi, Jenny."
 },
 {
  "id": 42,
  "start": 92.229,
  "end": 93.864,
  "text": "Well, my story began when"
 },
 {
  "id": 43,
  "start": 93.889,
  "end": 95.754,
  "text": "one day I had to walk up a hill."
 },
 {
  "id": 44,
  "start": 96.417,
  "end": 97.377,
  "text": "When I got to the top,"
 },
 {
  "id": 45,
  "start": 97.402,
  "end": 98.933,
  "text": "it was difficult to breathe."
 },
 {
  "id": 46,
  "start": 99.245,
  "end": 100.641,
  "text": "I was so unfit!"
 },
 {
  "id": 47,
  "start": 100.944,
  "end": 104.033,
  "text": "The problem is I really hate most kinds of exercise –"
 },
 {
  "id": 48,
  "start": 104.097,
  "end": 106.98,
  "text": "you know, running, cycling, swimming..."
 },
 {
  "id": 49,
  "start": 107.285,
  "end": 110.745,
  "text": "Then this friend said, ‘Why don’t you come to a dance class?’"
 },
 {
  "id": 50,
  "start": 111.392,
  "end": 114.766,
  "text": "The first time was so hard, I had to sit down and rest."
 },
 {
  "id": 51,
  "start": 114.801,
  "end": 117.071,
  "text": "But … but I enjoyed it…"
 },
 {
  "id": 52,
  "start": 117.916,
  "end": 119.59,
  "text": "So I went back again …"
 },
 {
  "id": 53,
  "start": 120.037,
  "end": 120.973,
  "text": "and again."
 },
 {
  "id": 54,
  "start": 121.659,
  "end": 123.493,
  "text": "And very slowly I’m getting fitter"
 },
 {
  "id": 55,
  "start": 123.518,
  "end": 124.683,
  "text": "and losing weight."
 },
 {
  "id": 56,
  "start": 125.249,
  "end": 127.13,
  "text": "I climbed that hill again last week –"
 },
 {
  "id": 57,
  "start": 127.274,
  "end": 127.98,
  "text": "easy!"
 },
 {
  "id": 58,
  "start": 128.005,
  "end": 129.934,
  "text": "That’s great Silvia."
 },
 {
  "id": 59,
  "start": 130.404,
  "end": 132.126,
  "text": "I really need to get fit myself!"
 },
 {
  "id": 60,
  "start": 133.254,
  "end": 138.045,
  "text": "Anyhow, last up we have Lucas. Hi Lucas."
 },
 {
  "id": 61,
  "start": 138.07,
  "end": 138.825,
  "text": "Hi."
 },
 {
  "id": 62,
  "start": 138.85,
  "end": 141.951,
  "text": "So, Lucas what did you need to change?"
 },
 {
  "id": 63,
  "start": 142.057,
  "end": 144.472,
  "text": "Well, about six months ago"
 },
 {
  "id": 64,
  "start": 144.497,
  "end": 146.75,
  "text": "I realised that I had a very"
 },
 {
  "id": 65,
  "start": 146.775,
  "end": 148.123,
  "text": "small number of friends."
 },
 {
  "id": 66,
  "start": 148.937,
  "end": 150.406,
  "text": "But if I thought back …"
 },
 {
  "id": 67,
  "start": 150.455,
  "end": 153.343,
  "text": "well, seven, eight years ago,"
 },
 {
  "id": 68,
  "start": 153.415,
  "end": 155.633,
  "text": "I used to have a lot of friends."
 },
 {
  "id": 69,
  "start": 156.461,
  "end": 159.335,
  "text": "And I asked myself, why is that?"
 },
 {
  "id": 70,
  "start": 159.974,
  "end": 162.419,
  "text": "Well, some of them got married"
 },
 {
  "id": 71,
  "start": 162.444,
  "end": 163.872,
  "text": "and had children"
 },
 {
  "id": 72,
  "start": 164.279,
  "end": 165.708,
  "text": "and their lives sort of"
 },
 {
  "id": 73,
  "start": 165.733,
  "end": 167.162,
  "text": "went in another direction."
 },
 {
  "id": 74,
  "start": 167.966,
  "end": 169.363,
  "text": "And a couple of friends"
 },
 {
  "id": 75,
  "start": 169.388,
  "end": 171.214,
  "text": "got job offers overseas."
 },
 {
  "id": 76,
  "start": 172.298,
  "end": 174.901,
  "text": "But when I thought about it a bit more,"
 },
 {
  "id": 77,
  "start": 174.926,
  "end": 177.346,
  "text": "well, another answer was"
 },
 {
  "id": 78,
  "start": 177.371,
  "end": 178.856,
  "text": "I’m a bit lazy –"
 },
 {
  "id": 79,
  "start": 179.12,
  "end": 181.454,
  "text": "lazy about keeping in touch with people."
 },
 {
  "id": 80,
  "start": 182.186,
  "end": 186.216,
  "text": "I see. So what did you do about it?"
 },
 {
  "id": 81,
  "start": 186.692,
  "end": 188.756,
  "text": "So I started to get in touch"
 },
 {
  "id": 82,
  "start": 188.781,
  "end": 190.344,
  "text": "with my old friends."
 },
 {
  "id": 83,
  "start": 190.879,
  "end": 192.688,
  "text": "And then, after that,"
 },
 {
  "id": 84,
  "start": 192.96,
  "end": 194.69,
  "text": "I had to stay in contact"
 },
 {
  "id": 85,
  "start": 194.715,
  "end": 196.509,
  "text": "and arrange to meet them again."
 },
 {
  "id": 86,
  "start": 197.057,
  "end": 199.552,
  "text": "Now I find that people call me!"
 },
 {
  "id": 87,
  "start": 200.27,
  "end": 201.873,
  "text": "And the great thing is"
 },
 {
  "id": 88,
  "start": 201.898,
  "end": 203.224,
  "text": "we still enjoy the"
 },
 {
  "id": 89,
  "start": 203.249,
  "end": 204.589,
  "text": "things that we used to."
 },
 {
  "id": 90,
  "start": 204.965,
  "end": 208.778,
  "text": "Well thanks so much guys for sharing your story with us."
 },
 {
  "id": 91,
  "start": 209.009,
  "end": 210.676,
  "text": "It just shows that we can"
 },
 {
  "id": 92,
  "start": 210.701,
  "end": 212.074,
  "text": "all make that change"
 },
 {
  "id": 93,
  "start": 212.099,
  "end": 213.789,
  "text": "if we decide to do it!"
 }
]