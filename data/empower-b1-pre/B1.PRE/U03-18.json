[
 {
  "id": 1,
  "start": 0.429,
  "end": 2.516,
  "text": "Track 03.18"
 },
 {
  "id": 2,
  "start": 3.325,
  "end": 4.293,
  "text": "Shona"
 },
 {
  "id": 3,
  "start": 5.146,
  "end": 6.583,
  "text": "I support Oxfam."
 },
 {
  "id": 4,
  "start": 6.806,
  "end": 7.361,
  "text": "You see,"
 },
 {
  "id": 5,
  "start": 7.838,
  "end": 10.496,
  "text": "I had a really happy childhood myself"
 },
 {
  "id": 6,
  "start": 10.808,
  "end": 12.895,
  "text": "and I think it’s important to help other"
 },
 {
  "id": 7,
  "start": 12.92,
  "end": 15.618,
  "text": "people in poorer countries have happy childhoods."
 },
 {
  "id": 8,
  "start": 16.438,
  "end": 18.295,
  "text": "I haven’t got a lot of spare money,"
 },
 {
  "id": 9,
  "start": 18.724,
  "end": 20.748,
  "text": "but I try and help them in other ways."
 },
 {
  "id": 10,
  "start": 21.218,
  "end": 23.52,
  "text": "For example, last year"
 },
 {
  "id": 11,
  "start": 23.712,
  "end": 24.91,
  "text": "I ran a marathon and"
 },
 {
  "id": 12,
  "start": 24.935,
  "end": 26.069,
  "text": "people sponsored me,"
 },
 {
  "id": 13,
  "start": 26.397,
  "end": 26.857,
  "text": "you know,"
 },
 {
  "id": 14,
  "start": 26.882,
  "end": 28.603,
  "text": "gave me money for doing the run."
 },
 {
  "id": 15,
  "start": 29.28,
  "end": 31.399,
  "text": "I made just over a hundred pounds."
 },
 {
  "id": 16,
  "start": 31.621,
  "end": 33.525,
  "text": "And then, once a month,"
 },
 {
  "id": 17,
  "start": 33.74,
  "end": 34.534,
  "text": "I make cakes"
 },
 {
  "id": 18,
  "start": 34.559,
  "end": 36.106,
  "text": "and take them to my office."
 },
 {
  "id": 19,
  "start": 36.56,
  "end": 38.742,
  "text": "I sell pieces of cake to my colleagues"
 },
 {
  "id": 20,
  "start": 38.767,
  "end": 39.759,
  "text": "for morning tea"
 },
 {
  "id": 21,
  "start": 39.784,
  "end": 41.465,
  "text": "and give the money to Oxfam."
 },
 {
  "id": 22,
  "start": 42.15,
  "end": 42.912,
  "text": "Jack"
 },
 {
  "id": 23,
  "start": 43.921,
  "end": 45.667,
  "text": "Well, giving to charity is"
 },
 {
  "id": 24,
  "start": 45.692,
  "end": 46.802,
  "text": "quite easy really."
 },
 {
  "id": 25,
  "start": 47.186,
  "end": 49.598,
  "text": "You can go online and pay with your credit card."
 },
 {
  "id": 26,
  "start": 50.037,
  "end": 53.212,
  "text": "I’ve given money to Greenpeace that way a few times recently."
 },
 {
  "id": 27,
  "start": 53.706,
  "end": 54.491,
  "text": "And once a year,"
 },
 {
  "id": 28,
  "start": 54.516,
  "end": 55.754,
  "text": "I sell their calendars –"
 },
 {
  "id": 29,
  "start": 56.001,
  "end": 58.271,
  "text": "mostly to friends and the people I work with."
 },
 {
  "id": 30,
  "start": 58.949,
  "end": 60.329,
  "text": "I think that helping to save our"
 },
 {
  "id": 31,
  "start": 60.354,
  "end": 63.164,
  "text": "natural world is the most important thing you can do."
 },
 {
  "id": 32,
  "start": 63.745,
  "end": 65.618,
  "text": "I think I should do something now –"
 },
 {
  "id": 33,
  "start": 65.811,
  "end": 67.224,
  "text": "so that my children"
 },
 {
  "id": 34,
  "start": 67.249,
  "end": 68.755,
  "text": "and my children’s children"
 },
 {
  "id": 35,
  "start": 68.931,
  "end": 71.217,
  "text": "can enjoy the kind of world that I live in."
 },
 {
  "id": 36,
  "start": 72.339,
  "end": 73.22,
  "text": "Jessica"
 },
 {
  "id": 37,
  "start": 74.389,
  "end": 75.5,
  "text": "Of course, I think it’s"
 },
 {
  "id": 38,
  "start": 75.525,
  "end": 76.842,
  "text": "important to …"
 },
 {
  "id": 39,
  "start": 76.867,
  "end": 79.541,
  "text": "well, that people give money to charities."
 },
 {
  "id": 40,
  "start": 80.042,
  "end": 80.963,
  "text": "But actually,"
 },
 {
  "id": 41,
  "start": 81.082,
  "end": 83.32,
  "text": "I haven’t got a lot of money myself."
 },
 {
  "id": 42,
  "start": 83.721,
  "end": 85.808,
  "text": "I owe money to my parents"
 },
 {
  "id": 43,
  "start": 85.953,
  "end": 87.707,
  "text": "and I have to pay back the government"
 },
 {
  "id": 44,
  "start": 87.732,
  "end": 89.852,
  "text": "for my university study and …"
 },
 {
  "id": 45,
  "start": 90.537,
  "end": 91.979,
  "text": "In fact, I’ve never"
 },
 {
  "id": 46,
  "start": 92.004,
  "end": 93.829,
  "text": "given any money to a charity."
 },
 {
  "id": 47,
  "start": 94.345,
  "end": 96.179,
  "text": "I can’t really afford it."
 },
 {
  "id": 48,
  "start": 97.088,
  "end": 98.064,
  "text": "William"
 },
 {
  "id": 49,
  "start": 98.915,
  "end": 101.383,
  "text": "Our history is really important,"
 },
 {
  "id": 50,
  "start": 101.655,
  "end": 103.306,
  "text": "and we need to protect it."
 },
 {
  "id": 51,
  "start": 103.578,
  "end": 104.887,
  "text": "When I think of all the old"
 },
 {
  "id": 52,
  "start": 104.912,
  "end": 107.063,
  "text": "buildings and important cultural sites"
 },
 {
  "id": 53,
  "start": 107.088,
  "end": 108.404,
  "text": "that we’ve already lost,"
 },
 {
  "id": 54,
  "start": 108.645,
  "end": 109.502,
  "text": "it’s terrible."
 },
 {
  "id": 55,
  "start": 109.781,
  "end": 111.623,
  "text": "So once every six months,"
 },
 {
  "id": 56,
  "start": 111.735,
  "end": 113.164,
  "text": "I go around my neighbourhood"
 },
 {
  "id": 57,
  "start": 113.189,
  "end": 114.838,
  "text": "and collect money door-to-door"
 },
 {
  "id": 58,
  "start": 115.008,
  "end": 119.12,
  "text": "for the United Nations Educational, Scientific and Cultural Organization –"
 },
 {
  "id": 59,
  "start": 119.272,
  "end": 120.733,
  "text": "you know, UNESCO."
 },
 {
  "id": 60,
  "start": 120.972,
  "end": 123.059,
  "text": "I tell people about all the cultural and"
 },
 {
  "id": 61,
  "start": 123.084,
  "end": 124.656,
  "text": "historical places UNESCO"
 },
 {
  "id": 62,
  "start": 124.681,
  "end": 125.537,
  "text": "wants to protect"
 },
 {
  "id": 63,
  "start": 125.712,
  "end": 127.124,
  "text": "and how it tries to promote"
 },
 {
  "id": 64,
  "start": 127.149,
  "end": 128.323,
  "text": "peace around the world."
 },
 {
  "id": 65,
  "start": 128.618,
  "end": 129.896,
  "text": "When people hear this,"
 },
 {
  "id": 66,
  "start": 130.033,
  "end": 131.62,
  "text": "they are usually very interested"
 },
 {
  "id": 67,
  "start": 131.778,
  "end": 133.452,
  "text": "and very generous."
 }
]