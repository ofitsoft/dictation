[
 {
  "id": 1,
  "start": 1.04,
  "end": 1.85,
  "text": "Woman: Wait."
 },
 {
  "id": 2,
  "start": 1.55,
  "end": 6.14,
  "text": "I thought you were just walking through the hotel to go outside and get something to eat."
 },
 {
  "id": 3,
  "start": 5.84,
  "end": 8.47,
  "text": "Why are we stopping at these slot machines?"
 },
 {
  "id": 4,
  "start": 8.17,
  "end": 9.88,
  "text": "Are you going to gamble?"
 },
 {
  "id": 5,
  "start": 9.58,
  "end": 11.03,
  "text": "Man: What?"
 },
 {
  "id": 6,
  "start": 10.73,
  "end": 11.59,
  "text": "Who me?"
 },
 {
  "id": 7,
  "start": 11.29,
  "end": 14.96,
  "text": "Hey, I’ll meet you back at the conference room with the rest (of the people)."
 },
 {
  "id": 8,
  "start": 14.66,
  "end": 17.43,
  "text": "Woman: Uh, no. I’m staying right with you."
 },
 {
  "id": 9,
  "start": 17.13,
  "end": 18.91,
  "text": "Does your Sara know about this?"
 },
 {
  "id": 10,
  "start": 18.61,
  "end": 20.25,
  "text": "Man: About what?"
 },
 {
  "id": 11,
  "start": 19.95,
  "end": 24.13,
  "text": "I just have some change in my pocket, and I thought I’d get rid of it."
 },
 {
  "id": 12,
  "start": 23.83,
  "end": 24.96,
  "text": "See, look."
 },
 {
  "id": 13,
  "start": 24.66,
  "end": 26.94,
  "text": "I have about five bucks or so."
 },
 {
  "id": 14,
  "start": 26.64,
  "end": 32.09,
  "text": "Hey, and besides, your wife doesn’t need to know about everything you do, does she?"
 },
 {
  "id": 15,
  "start": 31.79,
  "end": 34.42,
  "text": "Woman: Uh, no. This is different."
 },
 {
  "id": 16,
  "start": 34.12,
  "end": 41.9,
  "text": "You lost about $1,500 the last time we came here, and wait, why are you taking out your credit card?"
 },
 {
  "id": 17,
  "start": 41.6,
  "end": 42.95,
  "text": "Man: What?"
 },
 {
  "id": 18,
  "start": 42.65,
  "end": 43.78,
  "text": "Oh this?"
 },
 {
  "id": 19,
  "start": 43.48,
  "end": 46.08,
  "text": "I’m just going to buy a sandwich."
 },
 {
  "id": 20,
  "start": 45.78,
  "end": 47.2,
  "text": "Woman: Oh, no. Give me that."
 },
 {
  "id": 21,
  "start": 46.9,
  "end": 48.23,
  "text": "Man: Oh, okay."
 },
 {
  "id": 22,
  "start": 47.93,
  "end": 49.43,
  "text": "Here’s my jacket."
 },
 {
  "id": 23,
  "start": 49.13,
  "end": 51.18,
  "text": "Woman: No, not your jacket."
 },
 {
  "id": 24,
  "start": 50.88,
  "end": 52.53,
  "text": "Give me the credit card."
 },
 {
  "id": 25,
  "start": 52.23,
  "end": 53.45,
  "text": "Man: Really?"
 },
 {
  "id": 26,
  "start": 53.15,
  "end": 54.89,
  "text": "Don’t you trust me?"
 },
 {
  "id": 27,
  "start": 54.59,
  "end": 60.02,
  "text": "Woman: No. Let’s use that credit card to get dinner for the rest of the group."
 }
]