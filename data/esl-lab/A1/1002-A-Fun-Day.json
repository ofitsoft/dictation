[
 {
  "id": 1,
  "start": 0.19,
  "end": 1.3,
  "text": "Dad, I’m bored today."
 },
 {
  "id": 2,
  "start": 1.35,
  "end": 3.21,
  "text": "I want to go to a movie?"
 },
 {
  "id": 3,
  "start": 3.25,
  "end": 6.98,
  "text": "A movie today? Well, I don’t know. Here."
 },
 {
  "id": 4,
  "start": 7.06,
  "end": 8.34,
  "text": "Let me look at the newspaper."
 },
 {
  "id": 5,
  "start": 8.85,
  "end": 14.11,
  "text": "Okay. Ah, here’s a movie that starts in the afternoon at 2:45."
 },
 {
  "id": 6,
  "start": 14.33,
  "end": 16.05,
  "text": "Well, should we take mommy with us?"
 },
 {
  "id": 7,
  "start": 16.09,
  "end": 16.59,
  "text": "Yeah."
 },
 {
  "id": 8,
  "start": 16.63,
  "end": 20.3,
  "text": "Okay, we have to wait for mommy because she’s at a meeting right now."
 },
 {
  "id": 9,
  "start": 20.34,
  "end": 21.24,
  "text": "Okay."
 },
 {
  "id": 10,
  "start": 21.33,
  "end": 24.59,
  "text": "Alright. And what should we do after we see the movie?"
 },
 {
  "id": 11,
  "start": 24.64,
  "end": 25.95,
  "text": "Go on a walk."
 },
 {
  "id": 12,
  "start": 26.0,
  "end": 28.03,
  "text": "Well, where would you like to go on a walk?"
 },
 {
  "id": 13,
  "start": 28.07,
  "end": 30.37,
  "text": "Would you like to go down to the beach or through the park?"
 },
 {
  "id": 14,
  "start": 30.47,
  "end": 31.68,
  "text": "To the beach."
 },
 {
  "id": 15,
  "start": 31.72,
  "end": 33.61,
  "text": "To the beach. Well, that sounds great."
 },
 {
  "id": 16,
  "start": 33.61,
  "end": 35.75,
  "text": "And then maybe we can go out to eat tonight."
 },
 {
  "id": 17,
  "start": 35.75,
  "end": 37.05,
  "text": "Does that sound okay?"
 },
 {
  "id": 18,
  "start": 37.12,
