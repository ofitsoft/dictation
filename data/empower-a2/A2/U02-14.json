[
 {
  "id": 1,
  "start": 0.001,
  "end": 2.001,
  "text": "Track 02.14"
 },
 {
  "id": 2,
  "start": 2.992,
  "end": 3.921,
  "text": "PART 2"
 },
 {
  "id": 3,
  "start": 5.519,
  "end": 7.948,
  "text": "Hi, Dan. Sorry to call you at work."
 },
 {
  "id": 4,
  "start": 8.099,
  "end": 9.218,
  "text": "That’s OK. Don’t worry."
 },
 {
  "id": 5,
  "start": 9.353,
  "end": 12.82,
  "text": "But you see, I need … Well, I’d like some help."
 },
 {
  "id": 6,
  "start": 12.821,
  "end": 14.183,
  "text": "Sure, no problem."
 },
 {
  "id": 7,
  "start": 14.464,
  "end": 16.209,
  "text": "It’s about this online course I want to do."
 },
 {
  "id": 8,
  "start": 16.804,
  "end": 18.044,
  "text": "I’m not sure which one …"
 },
 {
  "id": 9,
  "start": 18.209,
  "end": 20.035,
  "text": "I mean, I can’t decide."
 },
 {
  "id": 10,
  "start": 20.416,
  "end": 22.416,
  "text": "So you want your big brother to help you …"
 },
 {
  "id": 11,
  "start": 22.661,
  "end": 23.796,
  "text": "Yes, I do."
 },
 {
  "id": 12,
  "start": 24.209,
  "end": 25.59,
  "text": "Could I come to your place tonight?"
 },
 {
  "id": 13,
  "start": 25.907,
  "end": 27.505,
  "text": "Sorry, we’re not at home tonight."
 },
 {
  "id": 14,
  "start": 27.687,
  "end": 28.807,
  "text": "Oh, that’s a pity."
 },
 {
  "id": 15,
  "start": 29.021,
  "end": 29.815,
  "text": "But, look,"
 },
 {
  "id": 16,
  "start": 29.839,
  "end": 31.624,
  "text": "come on Friday – for dinner."
 },
 {
  "id": 17,
  "start": 31.663,
  "end": 32.203,
  "text": "Friday?"
 },
 {
  "id": 18,
  "start": 32.378,
  "end": 32.735,
  "text": "Yes."
 },
 {
  "id": 19,
  "start": 32.791,
  "end": 33.415,
  "text": "For dinner?"
 },
 {
  "id": 20,
  "start": 33.598,
  "end": 34.121,
  "text": "Yes!"
 },
 {
  "id": 21,
  "start": 34.32,
  "end": 34.828,
  "text": "Lovely!"
 },
 {
  "id": 22,
  "start": 34.914,
  "end": 37.145,
  "text": "OK. See you then. Bye!"
 },
 {
  "id": 23,
  "start": 37.208,
  "end": 37.963,
  "text": "Bye!"
 },
 {
  "id": 24,
  "start": 38.081,
  "end": 38.788,
  "text": "My sister!"
 },
 {
  "id": 25,
  "start": 39.335,
  "end": 40.923,
  "text": "Always asking me to do things for her. ..."
 },
 {
  "id": 26,
  "start": 43.151,
  "end": 44.119,
  "text": "Ugh!"
 },
 {
  "id": 27,
  "start": 44.834,
  "end": 45.914,
  "text": "Too much sugar!"
 }
]