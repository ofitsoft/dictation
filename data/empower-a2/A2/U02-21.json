[
 {
  "id": 1,
  "start": 0.026,
  "end": 1.941,
  "text": "Track 02.21"
 },
 {
  "id": 2,
  "start": 2.424,
  "end": 3.803,
  "text": "My name is Daniela"
 },
 {
  "id": 3,
  "start": 3.803,
  "end": 6.431,
  "text": "and I’m a police officer in Mexico City –"
 },
 {
  "id": 4,
  "start": 7.043,
  "end": 8.65,
  "text": "but just traffic police."
 },
 {
  "id": 5,
  "start": 9.298,
  "end": 10.989,
  "text": "I need to speak English"
 },
 {
  "id": 6,
  "start": 11.026,
  "end": 12.652,
  "text": "because sometimes tourists"
 },
 {
  "id": 7,
  "start": 12.652,
  "end": 14.609,
  "text": "ask me questions in English,"
 },
 {
  "id": 8,
  "start": 15.045,
  "end": 16.089,
  "text": "for example,"
 },
 {
  "id": 9,
  "start": 17.039,
  "end": 18.854,
  "text": "they ask me for directions"
 },
 {
  "id": 10,
  "start": 18.891,
  "end": 20.809,
  "text": "or some tourist information."
 },
 {
  "id": 11,
  "start": 21.685,
  "end": 23.772,
  "text": "I like studying at this college."
 },
 {
  "id": 12,
  "start": 24.023,
  "end": 25.684,
  "text": "The timetable works well –"
 },
 {
  "id": 13,
  "start": 26.11,
  "end": 28.936,
  "text": "we have a two-hour break in the middle of the day."
 },
 {
  "id": 14,
  "start": 29.931,
  "end": 32.012,
  "text": "I want to improve my listening."
 },
 {
  "id": 15,
  "start": 32.485,
  "end": 34.324,
  "text": "I find listening quite hard"
 },
 {
  "id": 16,
  "start": 34.661,
  "end": 36.414,
  "text": "and it’s difficult to listen"
 },
 {
  "id": 17,
  "start": 36.526,
  "end": 38.869,
  "text": "to something and make notes at the same time."
 },
 {
  "id": 18,
  "start": 39.382,
  "end": 42.181,
  "text": "So I need to do some extra listening practice."
 }
]