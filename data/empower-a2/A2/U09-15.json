  "start": 10.829,
  "end": 12.069,
  "text": "Dan. Hi."
 },
 {
  "id": 4,
  "start": 12.46,
  "end": 13.997,
  "text": "Hi, Annie, how are things?"
 },
 {
  "id": 5,
  "start": 14.326,
  "end": 14.886,
  "text": "Fine."
 },
 {
  "id": 6,
  "start": 16.396,
  "end": 19.127,
  "text": "Um, look. Are you free at lunchtime?"
 },
 {
  "id": 7,
  "start": 19.895,
  "end": 20.574,
  "text": "Yes."
 },
 {
  "id": 8,
  "start": 21.075,
  "end": 23.18,
  "text": "Great. Could we meet?"
 },
 {
  "id": 9,
  "start": 23.884,
  "end": 25.615,
  "text": "I need help to buy some clothes for this evening."
 },
 {
  "id": 10,
  "start": 26.286,
  "end": 27.144,
  "text": "Yeah, sure."
 },
 {
  "id": 11,
  "start": 27.708,
  "end": 28.812,
  "text": "But what about Martina?"
 },
 {
  "id": 12,
  "start": 28.939,
  "end": 29.63,
  "text": "Can’t she help?"
 },
 {
  "id": 13,
  "start": 29.63,
  "end": 31.489,
  "text": "Well I’m meeting her this evening for dinner."
 },
 {
  "id": 14,
  "start": 31.929,
  "end": 33.641,
  "text": "She always says I wear the same old clothes,"
 },
 {
  "id": 15,
  "start": 34.126,
  "end": 35.544,
  "text": "so I want to get something new."
 },
 {
  "id": 16,
  "start": 35.897,
  "end": 37.074,
  "text": "I want to surprise her."
 },
 {
  "id": 17,
  "start": 38.067,
  "end": 39.423,
  "text": "OK, sure."
 },
 {
  "id": 18,
  "start": 40.038,
  "end": 41.738,
  "text": "I’m free at 12.30."
 }
