[
 {
  "id": 1,
  "start": 0.001,
  "end": 1.81,
  "text": "Track 10.13"
 },
 {
  "id": 2,
  "start": 3.079,
  "end": 3.785,
  "text": "PART 2"
 },
 {
  "id": 3,
  "start": 10.595,
  "end": 12.357,
  "text": "So you wanted some help."
 },
 {
  "id": 4,
  "start": 12.809,
  "end": 13.611,
  "text": "Oh yes –"
 },
 {
  "id": 5,
  "start": 13.952,
  "end": 15.214,
  "text": "I almost forgot."
 },
 {
  "id": 6,
  "start": 15.571,
  "end": 16.911,
  "text": "Everything’s fine –"
 },
 {
  "id": 7,
  "start": 17.038,
  "end": 18.157,
  "text": "it’s great."
 },
 {
  "id": 8,
  "start": 18.537,
  "end": 20.51,
  "text": "But I don’t know how"
 },
 {
  "id": 9,
  "start": 20.534,
  "end": 21.748,
  "text": "to get into my email."
 },
 {
  "id": 10,
  "start": 22.758,
  "end": 23.651,
  "text": "Can you have a look?"
 },
 {
  "id": 11,
  "start": 23.651,
  "end": 24.143,
  "text": "Sure."
 },
 {
  "id": 12,
  "start": 26.524,
  "end": 27.552,
  "text": "OK – that’s easy."
 },
 {
  "id": 13,
  "start": 27.552,
  "end": 29.329,
  "text": "You just need to change one small thing."
 },
 {
  "id": 14,
  "start": 29.877,
  "end": 31.071,
  "text": "OK. So what you do is …"
 },
 {
  "id": 15,
  "start": 31.388,
  "end": 32.42,
  "text": "touch this button here."
 },
 {
  "id": 16,
  "start": 32.658,
  "end": 33.253,
  "text": "OK."
 },
 {
  "id": 17,
  "start": 33.595,
  "end": 34.896,
  "text": "And a new screen opens."
 },
 {
  "id": 18,
  "start": 35.246,
  "end": 35.96,
  "text": "Oh yes."
 },
 {
  "id": 19,
  "start": 36.118,
  "end": 37.252,
  "text": "And now you just touch here"
 },
 {
  "id": 20,
  "start": 37.252,
  "end": 38.022,
  "text": "where it says ‘Yes’."
 },
 {
  "id": 21,
  "start": 38.078,
  "end": 40.078,
  "text": "Oh that’s easy."
 },
 {
  "id": 22,
  "start": 40.8,
  "end": 41.488,
  "text": "OK,"
 },
 {
  "id": 23,
  "start": 41.677,
  "end": 44.13,
  "text": "so first I touch this button?"
 },
 {
  "id": 24,
  "start": 44.496,
  "end": 45.054,
  "text": "That’s right."
 },
 {
  "id": 25,
  "start": 45.538,
  "end": 46.494,
  "text": "And it takes me"
 },
 {
  "id": 26,
  "start": 46.494,
  "end": 48.214,
  "text": "to a new screen – like this?"
 },
 {
  "id": 27,
  "start": 48.978,
  "end": 49.359,
  "text": "Correct."
 },
 {
  "id": 28,
  "start": 49.93,
  "end": 51.644,
  "text": "And I touch ‘Yes’."
 },
 {
  "id": 29,
  "start": 52.335,
  "end": 53.063,
  "text": "Is that right?"
 },
 {
  "id": 30,
  "start": 53.063,
  "end": 53.421,
  "text": "Yeah."
 },
 {
  "id": 31,
  "start": 54.245,
  "end": 55.294,
  "text": "Now you can check your email."
 },
 {
  "id": 32,
  "start": 57.159,
  "end": 57.781,
  "text": "Great."
 },
 {
  "id": 33,
  "start": 58.596,
  "end": 59.308,
  "text": "Thanks, Leo."
 },
 {
  "id": 34,
  "start": 59.887,
  "end": 60.895,
  "text": "Thank you so much."
 },
 {
  "id": 35,
  "start": 61.355,
  "end": 62.006,
  "text": "You’re welcome."
 },
 {
  "id": 36,
  "start": 62.8,
  "end": 63.427,
  "text": "Well, now I have"
 },
 {
  "id": 37,
  "start": 63.427,
  "end": 64.506,
  "text": "to buy you another coffee."
 },
 {
  "id": 38,
  "start": 65.447,
  "end": 66.034,
  "text": "Um"
 },
 {
  "id": 39,
  "start": 66.488,
  "end": 67.043,
  "text": "I think I have to"
 },
 {
  "id": 40,
  "start": 67.067,
  "end": 67.916,
  "text": "get back to work."
 },
 {
  "id": 41,
  "start": 68.083,
  "end": 68.575,
  "text": "I’ve got a meeting"
 },
 {
  "id": 42,
  "start": 68.575,
  "end": 69.678,
  "text": "with Dan in ten minutes."
 },
 {
  "id": 43,
  "start": 69.923,
  "end": 70.478,
  "text": "Dan?"
 },
 {
  "id": 44,
  "start": 70.573,
  "end": 72.248,
  "text": "Oh, don’t worry about him."
 },
 {
  "id": 45,
  "start": 72.319,
  "end": 73.494,
  "text": "Let’s have another coffee!"
 },
 {
  "id": 46,
  "start": 74.748,
  "end": 76.722,
  "text": "Well … OK!"
 }
]