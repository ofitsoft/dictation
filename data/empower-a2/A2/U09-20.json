[
 {
  "id": 1,
  "start": 0.498,
  "end": 2.225,
  "text": "Track 09.20"
 },
 {
  "id": 2,
  "start": 4.519,
  "end": 5.189,
  "text": "Axel"
 },
 {
  "id": 3,
  "start": 6.107,
  "end": 9.519,
  "text": "I always give my girlfriend an expensive birthday present."
 },
 {
  "id": 4,
  "start": 9.828,
  "end": 11.902,
  "text": "I don’t give her flowers or chocolates."
 },
 {
  "id": 5,
  "start": 12.423,
  "end": 13.791,
  "text": "I often give her jewellery,"
 },
 {
  "id": 6,
  "start": 13.792,
  "end": 15.715,
  "text": "maybe a necklace or earrings."
 },
 {
  "id": 7,
  "start": 16.039,
  "end": 17.618,
  "text": "Or maybe a beautiful dress."
 },
 {
  "id": 8,
  "start": 18.308,
  "end": 20.38,
  "text": "She loves expensive clothes."
 },
 {
  "id": 9,
  "start": 20.776,
  "end": 22.571,
  "text": "But clothes are difficult because"
 },
 {
  "id": 10,
  "start": 22.571,
  "end": 23.888,
  "text": "I don’t know what she likes."
 },
 {
  "id": 11,
  "start": 24.326,
  "end": 26.197,
  "text": "So, she usually chooses them"
 },
 {
  "id": 12,
  "start": 26.197,
  "end": 27.87,
  "text": "and then we buy them together."
 },
 {
  "id": 13,
  "start": 29.764,
  "end": 30.253,
  "text": "Bob"
 },
 {
  "id": 14,
  "start": 31.15,
  "end": 32.434,
  "text": "We don’t buy presents."
 },
 {
  "id": 15,
  "start": 33.129,
  "end": 34.964,
  "text": "We give the children some cash"
 },
 {
  "id": 16,
  "start": 34.965,
  "end": 37.277,
  "text": "and then they always buy their own presents."
 },
 {
  "id": 17,
  "start": 37.753,
  "end": 39.258,
  "text": "I think that’s better because"
 },
 {
  "id": 18,
  "start": 39.259,
  "end": 40.513,
  "text": "they know what they want."
 },
 {
  "id": 19,
  "start": 41.236,
  "end": 43.234,
  "text": "And then we do something nice together,"
 },
 {
  "id": 20,
  "start": 43.555,
  "end": 46.668,
  "text": "maybe go out for a meal or go to the cinema."
 },
 {
  "id": 21,
  "start": 48.568,
  "end": 49.343,
  "text": "Fernanda"
 },
 {
  "id": 22,
  "start": 50.298,
  "end": 53.34,
  "text": "We buy small birthday presents for the children –"
 },
 {
  "id": 23,
  "start": 53.801,
  "end": 56.652,
  "text": "usually toys or clothes,"
 },
 {
  "id": 24,
  "start": 56.885,
  "end": 59.825,
  "text": "something small, like a toy car"
 },
 {
  "id": 25,
  "start": 60.034,
  "end": 61.475,
  "text": "or a T-shirt maybe."
 },
 {
  "id": 26,
  "start": 62.266,
  "end": 65.636,
  "text": "Some people buy things like a laptop or a bike,"
 },
 {
  "id": 27,
  "start": 66.366,
  "end": 68.913,
  "text": "but I don’t like giving expensive presents,"
 },
 {
  "id": 28,
  "start": 69.351,
  "end": 71.463,
  "text": "I prefer to give small presents."
 },
 {
  "id": 29,
  "start": 73.518,
  "end": 74.146,
  "text": "Leila"
 },
 {
  "id": 30,
  "start": 75.322,
  "end": 78.044,
  "text": "My husband doesn’t think clothes"
 },
 {
  "id": 31,
  "start": 78.044,
  "end": 80.524,
  "text": "and computers are important."
 },
 {
  "id": 32,
  "start": 81.305,
  "end": 83.536,
  "text": "He doesn’t need many things –"
 },
 {
  "id": 33,
  "start": 84.025,
  "end": 87.146,
  "text": "he doesn’t like spending money on himself."
 },
 {
  "id": 34,
  "start": 87.943,
  "end": 92.287,
  "text": "But he reads lots of books and he likes music –"
 },
 {
  "id": 35,
  "start": 92.846,
  "end": 94.912,
  "text": "so for his birthday I usually"
 },
 {
  "id": 36,
  "start": 94.912,
  "end": 97.845,
  "text": "buy him a book or a record."
 },
 {
  "id": 37,
  "start": 99.118,
  "end": 100.494,
  "text": "He’s very easy!"
 }
]