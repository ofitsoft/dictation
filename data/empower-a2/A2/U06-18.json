  "end": 1.875,
  "text": "Track 06.18"
 },
 {
  "id": 2,
  "start": 2.976,
  "end": 6.007,
  "text": "When I was young, my hobby was playing the piano."
 },
 {
  "id": 3,
  "start": 6.486,
  "end": 8.035,
  "text": "I only liked jazz,"
 },
 {
  "id": 4,
  "start": 8.111,
  "end": 10.942,
  "text": "not modern or classical music."
 },
 {
  "id": 5,
  "start": 11.418,
  "end": 13.068,
  "text": "My parents bought me a piano"
 },
 {
  "id": 6,
  "start": 13.069,
  "end": 14.562,
  "text": "when I was eight years old,"
 },
 {
  "id": 7,
  "start": 14.563,
  "end": 16.07,
  "text": "and I started lessons then."
 },
 {
  "id": 8,
  "start": 16.662,
  "end": 18.662,
  "text": "They had a lot of jazz CDs,"
 },
 {
  "id": 9,
  "start": 18.922,
  "end": 20.922,
  "text": "and I always listened to them."
 },
 {
  "id": 10,
  "start": 21.204,
  "end": 23.204,
  "text": "They were happy for me to play jazz."
 },
 {
  "id": 11,
  "start": 23.572,
  "end": 26.101,
  "text": "I played jazz piano all the time."
 },
 {
  "id": 12,
  "start": 26.442,
  "end": 28.079,
  "text": "I still play the piano now"
 },
 {
  "id": 13,
  "start": 28.08,
  "end": 30.316,
  "text": "and jazz is my favourite music."
 }
]